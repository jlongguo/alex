<?xml version="1.0"?>
<!-- ROS TF/visualization description. Gazebo physics is defined in model.sdf. -->
<robot name="alex_bot">
  <material name="blue"><color rgba="0.20 0.62 0.80 1"/></material>
  <material name="dark"><color rgba="0.12 0.12 0.14 1"/></material>
  <link name="base_link">
    <visual><geometry><box size="0.25 0.20 0.12"/></geometry><material name="blue"/></visual>
  </link>
  <link name="lidar_link">
    <visual><geometry><cylinder length="0.04" radius="0.04"/></geometry><material name="dark"/></visual>
  </link>
  <joint name="base_to_lidar" type="fixed"><parent link="base_link"/><child link="lidar_link"/><origin xyz="0.07 0 0.10" rpy="0 0 0"/></joint>
  <!-- Fixed wheel visuals keep TF deterministic; physical wheel joints live in SDF. -->
  <link name="left_wheel"><visual><geometry><cylinder radius="0.07" length="0.035"/></geometry><material name="dark"/></visual></link>
  <link name="right_wheel"><visual><geometry><cylinder radius="0.07" length="0.035"/></geometry><material name="dark"/></visual></link>
  <joint name="left_wheel_mount" type="fixed"><parent link="base_link"/><child link="left_wheel"/><origin xyz="0 0.145 -0.09" rpy="1.5707963 0 0"/></joint>
  <joint name="right_wheel_mount" type="fixed"><parent link="base_link"/><child link="right_wheel"/><origin xyz="0 -0.145 -0.09" rpy="1.5707963 0 0"/></joint>
</robot>
