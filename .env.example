# Local simulation only; never expose the server on a public network.
PORT=4317
# Default mode uses deterministic parsing and needs no external AI access.
AGENT_PROVIDER=rules
# Optional: set ALL variables below and AGENT_PROVIDER=compatible for a real hosted model.
# AGENT_BASE_URL=https://your-trusted-provider.example/v1
# AGENT_MODEL=your-model-name
# AGENT_API_KEY=replace-with-secret (NEVER commit an actual key)
# STATE_FILE=.local/state.json

# v0.3: set local to enable verified family roles. Default demo mode is INSECURE.
# AUTH_MODE=local
# ALEX_PARENT_PASSWORD=choose-a-strong-password-at-least-12-characters
# ALEX_CHILD_PIN=123456  # Example ONLY; choose a unique 6–12 digit PIN
# MEMORY_FILE=.local/memory.json
# AUDIT_FILE=.local/audit.jsonl

# v0.4: all files stay on the local machine (no profile passwords in URLs).
# DEVICES_FILE=.local/devices.json
# PROFILES_FILE=.local/profiles.json
# AGENT_MEMORY_CONTEXT=0  # OPT-IN: set 1 to send short, role-filtered memory hints to the configured hosted LLM.

# v0.5: local-only virtual device command inbox (never a motor controller)
# GATEWAY_FILE=.local/gateway.json
# Pair devices as parent, then run scripts/virtual-device.mjs with ALEX_DEVICE_ID/TOKEN.

# v0.6 simulated workflow snapshots (no physical actuation)
WORKFLOW_FILE=.local/workflows.json

# Optional local-only plan snapshot file
PLAN_FILE=.local/plans.json

# v0.8: default rule-only proposal classifier; optional live model sends prompts to provider.
ALEX_PLAN_PROVIDER=rules
# ALEX_PLAN_PROVIDER=compatible
# PROPOSAL_FILE=.local/proposals.json

# v0.10: EXPERIMENTAL ROS 2/Nav2 integration for a matched Gazebo simulation ONLY.
# Defaults to the existing grid A* navigation simulation.
ALEX_NAV_BACKEND=grid
# ALEX_NAV_BACKEND=ros2
# ALEX_ROS_SIMULATION_ONLY=1
# ROS_DOMAIN_ID=30
# Requires ROS 2 Jazzy + nav2_msgs + rclpy + an active /clock and /navigate_to_pose.
# NEVER use with a physical robot: no certified safety interlock or stop guarantee.

# v0.11: explicit simulation-only ROS 2 Jazzy/Gazebo domain. No physical device.
# ALEX_ROS_SIMULATION_ONLY=1
# ROS_DOMAIN_ID=77
# ALEX_WITH_NAV2=true
# ALEX_RUN_ROS_INTEGRATION=1  # Only for manual smoke tests after launch

# AI Companion mainline (requires AUTH_MODE=local, never available in demo mode).
# Free-form model conversation is OFF by default; offline English and story work without keys.
ALEX_CHAT_PROVIDER=offline
# ALEX_CHAT_PROVIDER=compatible  # needs AGENT_BASE_URL, AGENT_MODEL, AGENT_API_KEY above
# Raw conversation transcripts are MEMORY ONLY unless explicitly enabled:
# ALEX_CONVERSATION_PERSIST=1
# ALEX_CONVERSATION_FILE=.local/conversations.json
# Warning: optional browser speech recognition may depend on external vendor services.
