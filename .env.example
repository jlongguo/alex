# Local simulation only; never expose the server on a public network.
PORT=4317
# Default mode uses deterministic parsing and needs no external AI access.
AGENT_PROVIDER=rules
# Optional: set ALL variables below and AGENT_PROVIDER=compatible for a real hosted model.
# AGENT_BASE_URL=https://your-trusted-provider.example/v1
# AGENT_MODEL=your-model-name
# AGENT_API_KEY=replace-with-secret (NEVER commit an actual key)
# STATE_FILE=.local/state.json

# v0.3: set local to enable verified family roles. Default demo mode is INSECURE.
# AUTH_MODE=local
# ALEX_PARENT_PASSWORD=choose-a-strong-password-at-least-12-characters
# ALEX_CHILD_PIN=123456  # Example ONLY; choose a unique 6–12 digit PIN
# MEMORY_FILE=.local/memory.json
# AUDIT_FILE=.local/audit.jsonl

# v0.4: all files stay on the local machine (no profile passwords in URLs).
# DEVICES_FILE=.local/devices.json
# PROFILES_FILE=.local/profiles.json
# AGENT_MEMORY_CONTEXT=0  # OPT-IN: set 1 to send short, role-filtered memory hints to the configured hosted LLM.

# v0.5: local-only virtual device command inbox (never a motor controller)
# GATEWAY_FILE=.local/gateway.json
# Pair devices as parent, then run scripts/virtual-device.mjs with ALEX_DEVICE_ID/TOKEN.

# v0.6 simulated workflow snapshots (no physical actuation)
WORKFLOW_FILE=.local/workflows.json
