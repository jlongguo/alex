{
  "name": "home-agent-os",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "description": "Local-first AI home hub and simulated robot navigation with an experimental Nav2 Action bridge for Gazebo only",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node scripts/server.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:wal-risks": "node scripts/wal-recovery-risks.mjs",
    "release:skill-compat": "node scripts/skill-state-compat.mjs",
    "release:skill-recovery": "node scripts/skill-recovery-evidence.mjs",
    "release:stage-audit": "node scripts/recovery-stage-audit.mjs",
    "dev": "npm run build && npm run start",
    "test": "npm run build && node --test --test-concurrency=2 tests/*.test.mjs",
    "test:browser": "node scripts/browser-acceptance.mjs",
    "check": "npm run build && node --test --test-concurrency=2 tests/*.test.mjs",
    "virtual-device": "node scripts/virtual-device.mjs",
    "sim:generate": "npm run build && node scripts/generate-sim-assets.mjs",
    "sim:check": "npm run build && node scripts/generate-sim-assets.mjs --check && python3 scripts/validate-ros-assets.py && python3 scripts/validate-ros-launch.py",
    "sim:launch": "bash scripts/launch-ros-sim.sh",
    "sim:smoke": "python3 robotics/ros2/alex_sim/scripts/ros_smoke.py",
    "sim:accept": "bash scripts/run-ros-acceptance.sh",
    "sim:accept-cancel": "ALEX_ROS_ACCEPTANCE_MODE=cancel-probe bash scripts/run-ros-acceptance.sh",
    "sim:accept-recovery": "ALEX_ROS_ACCEPTANCE_MODE=recover-probe bash scripts/run-ros-acceptance.sh",
    "sim:accept-bridge": "ALEX_ROS_ACCEPTANCE_MODE=bridge-probe bash scripts/run-ros-acceptance.sh",
    "sim:verify-bridge-report": "python3 scripts/verify-nav2-bridge-live-report.py",
    "sim:verify-recovery-report": "python3 scripts/verify-ros-recovery-report.py",
    "sim:bundle-collect": "python3 scripts/ros-workflow-evidence-bundle.py --collect",
    "sim:bundle-verify": "python3 scripts/ros-workflow-evidence-bundle.py --verify",
    "sim:artifact-attest": "python3 scripts/write-ros-artifact-attestation.py",
    "sim:artifact-verify": "python3 scripts/verify-ros-artifact-attestation.py",
    "sim:evidence-set-verify": "python3 scripts/verify-ros-evidence-set.py",
    "sim:github-readback": "python3 scripts/github-actions-ros-readback.py",
    "sim:publication-audit": "python3 scripts/github-actions-ros-publication-audit.py",
    "sim:verify-cancel-report": "python3 scripts/verify-ros-cancel-report.py",
    "sim:fault-contract": "npm run build && node scripts/nav2-fault-contract.mjs",
    "sim:verify-fault-contract": "node scripts/verify-nav2-fault-contract.mjs",
    "voice:accept": "node scripts/voice-runtime-acceptance.mjs",
    "voice:verify": "node scripts/verify-voice-runtime-report.mjs",
    "release:runtime-evidence": "python3 scripts/runtime-acceptance-gate.py",
    "sim:preflight": "python3 scripts/ros-preflight.py --json .local/ros/preflight.json"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.6.2+sha512.47870716bea1572b53df34ad8647b42962bc790ce2bf4562ba0f643237d7302a3d6a8ecef9e4bdfc01d23af1969aa90485d4cebb0b9638fa5ef1daef656f6c1b"
}
