{
  "name": "home-agent-os",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "description": "Local-first AI home hub and simulated robot navigation with an experimental Nav2 Action bridge for Gazebo only",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node scripts/server.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "dev": "npm run build && npm run start",
    "test": "npm run build && node --test --test-concurrency=2 tests/*.test.mjs",
    "check": "npm run build && node --test --test-concurrency=2 tests/*.test.mjs",
    "virtual-device": "node scripts/virtual-device.mjs",
    "sim:generate": "npm run build && node scripts/generate-sim-assets.mjs",
    "sim:check": "npm run build && node scripts/generate-sim-assets.mjs --check && python3 scripts/validate-ros-assets.py && python3 scripts/validate-ros-launch.py",
    "sim:launch": "bash scripts/launch-ros-sim.sh",
    "sim:smoke": "python3 robotics/ros2/alex_sim/scripts/ros_smoke.py",
    "sim:accept": "bash scripts/run-ros-acceptance.sh",
    "sim:preflight": "python3 scripts/ros-preflight.py --json .local/ros/preflight.json"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.6.2+sha512.47870716bea1572b53df34ad8647b42962bc790ce2bf4562ba0f643237d7302a3d6a8ecef9e4bdfc01d23af1969aa90485d4cebb0b9638fa5ef1daef656f6c1b"
}
