{
  "name": "home-agent-os",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Local-first home hub with family auth, opt-in agent, virtual device gateway, orchestrated workflows, bounded plans, durable plan events and simulation",
